# --- App ---
NODE_ENV=development
PORT=3000
# Publicly reachable https URL (ngrok tunnel or deployed host) that AT's Voice API
# calls back to for GetDigits (agent OTP capture, M3) and any future Record/Conference
# flows. Must be https - AT's ActionBuilder schema rejects http callback URLs.
PUBLIC_BASE_URL=https://CHANGE_ME.ngrok-free.app
# Origin of the M8 Next.js dashboard, for CORS.
DASHBOARD_ORIGIN=http://localhost:3001
# HMAC secret for signing dashboard JWTs (M8). Required, min 32 chars, no
# fallback — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32
# Shared secret appended as ?token=... to AT callback URLs configured in the AT
# dashboard (ussd/callback, sms/inbound, voice/callback, voice/agent-otp-digits,
# voice/record-intro-complete) — AT has no request-signing of its own, so this is
# what stops arbitrary internet POSTs to those routes. Generate with: openssl rand -hex 16
AT_WEBHOOK_SECRET=replace-with-openssl-rand-hex-16

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rabtalink
POSTGRES_PASSWORD=rabtalink
POSTGRES_DB=rabtalink
# Used by TypeORM CLI running on the host (outside docker), points at localhost instead of the postgres service name
DATABASE_URL=postgresql://rabtalink:rabtalink@localhost:5432/rabtalink

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Africa's Talking sandbox ---
# Get these from https://account.africastalking.com (Sandbox app)
# NOTE (found during M0 build): username "sandbox" only resolves for SMS/USSD/Airtime
# (api.sandbox.africastalking.com is real; voice.sandbox.africastalking.com is NOT —
# it's an NXDOMAIN). The AT SDK has no sandbox host for Voice. To test Voice calls you
# must use your actual AT account username (not the literal string "sandbox"), pointed
# at a real app in test mode. Confirm this against the live sandbox dashboard during M3/M6.
AT_USERNAME=sandbox
AT_API_KEY=replace-with-sandbox-api-key
# Sandbox short code used for USSD/SMS testing (simulator supplies this in the AT sandbox UI)
AT_SHORTCODE=*384*1#
# Africa's Talking phone number/sender ID your Voice calls originate from (sandbox provides a test number)
AT_VOICE_NUMBER=+254700000000
